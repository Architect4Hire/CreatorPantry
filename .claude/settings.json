{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(ng build:*)",
      "Bash(ng test:*)",
      "Bash(ng lint:*)",
      "Bash(aspire run:*)",
      "Bash(aspire add:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(rg:*)",
      "Bash(dotnet build *)",
      "Bash(UPDATE_OPENAPI_SNAPSHOT=1 dotnet test src/CreatorPantry.Tests --filter \"FullyQualifiedName~OpenApiContract\" --nologo -v q)",
      "Bash(UPDATE_OPENAPI_SNAPSHOT=1 dotnet test src/CreatorPantry.Tests --nologo -- --filter \"/*/*/OpenApiContractTests/*\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter \"/*/*/OpenApiContractTests/*\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --list-tests)",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Api.OpenApiContractTests\")",
      "Bash(python -c ' *)",
      "Bash(sed -n '/\\\\\"UpdateRecipe\\\\\"/,/^ }/p' src/CreatorPantry.Tests/Api/Snapshots/openapi-v1.json)",
      "Bash(UPDATE_OPENAPI_SNAPSHOT=1 ./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Api.OpenApiContractTests\")",
      "Bash(python3 -c ' *)",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Patching.PatchFieldTests\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Recipes.UpdateRecipeViewModelValidatorTests\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Recipes.CanonicalRecipePatchTests\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Recipes.RecipeBusinessTests\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Recipes.RecipeFacadeTests\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Recipes.RecipeDataLayerTests\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-method \"The_second_writer_holding_a_stale_row_is_refused\")",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Recipes.RecipeUpdateEndpointTests\")",
      "Bash(sed -i 's/\"brand-new-tag\"/\"sourdough\"/g' src/CreatorPantry.Tests/Recipes/RecipeUpdateEndpointTests.cs)",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe)",
      "Bash(grep -v \"///\")",
      "Bash(grep -vi \"^\\\\S*:.*///\")",
      "Bash(grep -n \"const\\\\|///\")",
      "Bash(grep -n \"IsNullOrEmpty\\(command.Key\\)\\\\|KeyRequired$\\\\|new IdempotentOutcome<T>\\(await operation\\\\|RollbackAsync\\\\|ChangeTracker.Clear\" IdempotencyBusiness.cs IdempotencyDataLayer.cs)",
      "Bash(./bin/Debug/net10.0/CreatorPantry.Tests.exe --filter-class \"CreatorPantry.Tests.Gateway.EdgeReviewFixTests\")"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(dotnet ef database drop:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/secret-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/format.sh"
          }
        ]
      }
    ]
  }
}
