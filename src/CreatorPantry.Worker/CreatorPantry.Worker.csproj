<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-CreatorPantry.Worker-b49ebc20-bdea-4a00-a385-4fc52f6f984e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The blob client the private object store reads brand source documents through. This host has had
         .WithReference(blobs) since the AppHost declared it; document extraction is the first work here that
         actually opens one. -->
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.6.0" />
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.6.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CreatorPantry.AiProvider\CreatorPantry.AiProvider.csproj" />
    <ProjectReference Include="..\CreatorPantry.Domain\CreatorPantry.Domain.csproj" />
    <ProjectReference Include="..\CreatorPantry.ServiceDefaults\CreatorPantry.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CreatorPantry.Tests" />
  </ItemGroup>

  <!-- Application time: only IClock and ITimeZoneConverter may read the clock or resolve zones. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\BannedSymbols.txt" />
  </ItemGroup>

</Project>
