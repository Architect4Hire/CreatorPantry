{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Ai": {
    "Quota": {
      // The same entry the API carries, and for the same reason: the hold is taken here, immediately before
      // the first of the test drive's two provider calls, so the worker has to agree with the edge about what
      // one costs. See CreatorPantry.ApiService/appsettings.json.
      "TaskEstimates": {
        "BrandStyleTestDrive": 20,
        // Long-form may write up to Ai:Gateway's 8,000-token ceiling a call (AP.2.2), which is 12.5 credits at
        // gpt-5.4-nano's output rate; startup refuses an estimate below a task's ceiling. What is charged is
        // still what the call used — this sizes the hold, not the price.
        "LongFormOutline": 15,
        "LongFormSection": 15
      },
      // Credits per million reported tokens (AP.2.1), at the pinned unit of ai-pricing.md B-49: credits = list $ x
      // 1,250. Each figure is its Ai:Cost:Models price below times 1,250; ModelRateTableTests holds the two together.
      // A model's reported id may carry a snapshot date or a catalogue version, and AiModelRateKeys finds the
      // rate under the plain name. A model absent from here settles at the estimate, never at nothing. Embedding
      // calls are not metered yet, so its row is the price to charge once they are.
      "ModelRates": {
        "gpt-5.4-nano": { "CreditsPerMillionInputTokens": 250, "CreditsPerMillionOutputTokens": 1562.5 },
        "gpt-4o-mini": { "CreditsPerMillionInputTokens": 187.5, "CreditsPerMillionOutputTokens": 750 },
        "gpt-4.1-mini": { "CreditsPerMillionInputTokens": 500, "CreditsPerMillionOutputTokens": 2000 },
        "gpt-5-mini": { "CreditsPerMillionInputTokens": 312.5, "CreditsPerMillionOutputTokens": 2500 },
        "text-embedding-3-small": { "CreditsPerMillionInputTokens": 25, "CreditsPerMillionOutputTokens": 0 }
      }
    },
    // Provider list prices in USD per million tokens: Azure Foundry Models, Global Standard, from the Azure
    // Retail Prices API on 2026-10-26 (OpenAI's own list agrees). Cached input is billed at about a tenth of
    // input and is not told apart here, so a cached call is estimated slightly high, never low.
    "Cost": {
      "Models": {
        "gpt-5.4-nano": { "InputPerMillionTokens": 0.20, "OutputPerMillionTokens": 1.25 },
        "gpt-4o-mini": { "InputPerMillionTokens": 0.15, "OutputPerMillionTokens": 0.60 },
        "gpt-4.1-mini": { "InputPerMillionTokens": 0.40, "OutputPerMillionTokens": 1.60 },
        "gpt-5-mini": { "InputPerMillionTokens": 0.25, "OutputPerMillionTokens": 2.00 },
        "text-embedding-3-small": { "InputPerMillionTokens": 0.02, "OutputPerMillionTokens": 0 }
      }
    }
  }
}
