{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Venice": {
    // One sizing profile per Venice image model this host may send to (AP.2.3), from the model's own
    // model_spec.constraints in GET https://api.venice.ai/api/v1/models?type=image, read 2026-10-26. A model is
    // sized one way — Resolution (tier + aspect ratio, + quality when it lists qualities), AspectRatio, or Pixels —
    // and rejects the other ways' fields, so a request carries only its own. The defaults are this deployment's:
    // gpt-image-2-5-flare's own default quality is high ($0.07 at 1K); medium is $0.04. The configured model
    // (ConnectionStrings:images, Model=) must have a profile or the host does not start. VeniceProfileTableTests
    // holds the API's and the Worker's copies together.
    "Models": {
      "gpt-image-2-5-flare": {
        "Sizing": "Resolution",
        "Resolutions": [ "1K", "2K", "4K" ],
        "DefaultResolution": "1K",
        "Qualities": [ "low", "medium", "high" ],
        "DefaultQuality": "medium",
        "AspectRatios": [ "1:1", "3:2", "16:9", "21:9", "9:16", "2:3", "3:4", "4:5" ],
        "DefaultAspectRatio": "1:1",
        "PromptCharacterLimit": 10000
      },
      "qwen-image-2-1-turbo": {
        "Sizing": "Resolution",
        "Resolutions": [ "1K", "2K" ],
        "DefaultResolution": "1K",
        "AspectRatios": [ "1:1", "3:2", "16:9", "21:9", "9:16", "2:3", "3:4", "4:5" ],
        "DefaultAspectRatio": "1:1",
        "PromptCharacterLimit": 10000
      },
      "seedream-v5-lite": {
        "Sizing": "AspectRatio",
        "AspectRatios": [ "1:1", "3:2", "16:9", "21:9", "9:16", "2:3", "3:4", "4:5", "4:3" ],
        "DefaultAspectRatio": "1:1",
        "PromptCharacterLimit": 10000
      },
      "z-image-turbo": {
        "Sizing": "Pixels",
        "WidthHeightDivisor": 8,
        "MaxDimension": 1280,
        "DefaultWidth": 1024,
        "DefaultHeight": 1024,
        "PromptCharacterLimit": 7500
      }
    }
  },
  "Ai": {
    // Quality classes (AP.3.1, PRICE-006): what each one sends. A request names a class, never a model; one
    // that names none is made at DefaultClass. A class has no price of its own (B-55) — it costs the
    // Ai:Quota:ImageRates row for exactly the model, resolution and quality below, and startup refuses a class
    // this host cannot size (Venice:Models) or price. Draft is qwen-image-2-1-turbo rather than z-image-turbo
    // until AP.3.2: z-image takes 7,500 prompt characters and a composed prompt can reach about 8,000 (owner,
    // 2026-10-27). Standard is exactly what every picture was before classes. Identical in the API and the
    // Worker: the API prices a class and the Worker sends it (QualityClassTableTests).
    "Images": {
      "DefaultClass": "Standard",
      "Classes": {
        "Draft": { "Model": "qwen-image-2-1-turbo", "Resolution": "1K" },
        "Standard": { "Model": "gpt-image-2-5-flare", "Quality": "medium", "Resolution": "1K" },
        "High": { "Model": "gpt-image-2-5-flare", "Quality": "high", "Resolution": "1K" },
        "High2K": { "Model": "gpt-image-2-5-flare", "Quality": "high", "Resolution": "2K" },
        "High4K": { "Model": "gpt-image-2-5-flare", "Quality": "high", "Resolution": "4K" }
      }
    },
    "Quota": {
      // The same entry the API carries, and for the same reason: the hold is taken here, immediately before
      // the first of the test drive's two provider calls, so the worker has to agree with the edge about what
      // one costs. See CreatorPantry.ApiService/appsettings.json.
      "TaskEstimates": {
        "BrandStyleTestDrive": 20,
        // Long-form may write up to Ai:Gateway's 8,000-token ceiling a call (AP.2.2), which is 12.5 credits at
        // gpt-5.4-nano's output rate; startup refuses an estimate below a task's ceiling. What is charged is
        // still what the call used — this sizes the hold, not the price.
        "LongFormOutline": 15,
        "LongFormSection": 15
      },
      // Credits per image (AP.2.4), at the same pinned unit: credits = list $ per picture x 1,250
      // (ai-pricing.md B-49). Every figure below is the model's own list price from model_spec.pricing in
      // GET https://api.venice.ai/api/v1/models?type=image, read 2026-10-26 — the same reading the Venice
      // profiles above came from — and ImageRateTableTests holds each against its Ai:Cost:Images price.
      // The key is the model and the fields its request actually carries (AiImageRateKeys): "/" and not ":",
      // which is the configuration delimiter. Nothing falls back: 4K/high is never charged at 1K's rate, so
      // every quality and tier a profile offers needs its own row and startup refuses a host missing one. An
      // image with no rate is refused at admission, never made for nothing. Venice also prices upscale
      // (2x $0.02, 4x $0.08); CreatorPantry does not upscale, so there is no row for it to ride free on.
      "ImageRates": {
        "gpt-image-2-5-flare/1K/low": 37.5,
        "gpt-image-2-5-flare/1K/medium": 50,
        "gpt-image-2-5-flare/1K/high": 87.5,
        "gpt-image-2-5-flare/2K/low": 50,
        "gpt-image-2-5-flare/2K/medium": 62.5,
        "gpt-image-2-5-flare/2K/high": 187.5,
        "gpt-image-2-5-flare/4K/low": 62.5,
        "gpt-image-2-5-flare/4K/medium": 87.5,
        "gpt-image-2-5-flare/4K/high": 287.5,
        "qwen-image-2-1-turbo/1K": 25,
        "qwen-image-2-1-turbo/2K": 25,
        "seedream-v5-lite": 62.5,
        "z-image-turbo": 12.5
      },
      // Credits per million reported tokens (AP.2.1), at the pinned unit of ai-pricing.md B-49: credits = list $ x
      // 1,250. Each figure is its Ai:Cost:Models price below times 1,250; ModelRateTableTests holds the two together.
      // A model's reported id may carry a snapshot date or a catalogue version, and AiModelRateKeys finds the
      // rate under the plain name. A model absent from here settles at the estimate, never at nothing. Embedding
      // calls are not metered yet, so its row is the price to charge once they are.
      "ModelRates": {
        "gpt-5.4-nano": { "CreditsPerMillionInputTokens": 250, "CreditsPerMillionOutputTokens": 1562.5 },
        "gpt-4o-mini": { "CreditsPerMillionInputTokens": 187.5, "CreditsPerMillionOutputTokens": 750 },
        "gpt-4.1-mini": { "CreditsPerMillionInputTokens": 500, "CreditsPerMillionOutputTokens": 2000 },
        "gpt-5-mini": { "CreditsPerMillionInputTokens": 312.5, "CreditsPerMillionOutputTokens": 2500 },
        "text-embedding-3-small": { "CreditsPerMillionInputTokens": 25, "CreditsPerMillionOutputTokens": 0 }
      }
    },
    // Provider list prices in USD per million tokens: Azure Foundry Models, Global Standard, from the Azure
    // Retail Prices API on 2026-10-26 (OpenAI's own list agrees). Cached input is billed at about a tenth of
    // input and is not told apart here, so a cached call is estimated slightly high, never low.
    "Cost": {
      "Models": {
        "gpt-5.4-nano": { "InputPerMillionTokens": 0.20, "OutputPerMillionTokens": 1.25 },
        "gpt-4o-mini": { "InputPerMillionTokens": 0.15, "OutputPerMillionTokens": 0.60 },
        "gpt-4.1-mini": { "InputPerMillionTokens": 0.40, "OutputPerMillionTokens": 1.60 },
        "gpt-5-mini": { "InputPerMillionTokens": 0.25, "OutputPerMillionTokens": 2.00 },
        "text-embedding-3-small": { "InputPerMillionTokens": 0.02, "OutputPerMillionTokens": 0 }
      },
      // Venice list prices in USD per picture, the same rows as Ai:Quota:ImageRates above at list rather than
      // at the pinned credit unit. gpt-image-2-5-flare is priced by quality at each tier; qwen by tier alone;
      // seedream and z-image at one price a picture whatever the size asked for.
      "Images": {
        "gpt-image-2-5-flare/1K/low": 0.03,
        "gpt-image-2-5-flare/1K/medium": 0.04,
        "gpt-image-2-5-flare/1K/high": 0.07,
        "gpt-image-2-5-flare/2K/low": 0.04,
        "gpt-image-2-5-flare/2K/medium": 0.05,
        "gpt-image-2-5-flare/2K/high": 0.15,
        "gpt-image-2-5-flare/4K/low": 0.05,
        "gpt-image-2-5-flare/4K/medium": 0.07,
        "gpt-image-2-5-flare/4K/high": 0.23,
        "qwen-image-2-1-turbo/1K": 0.02,
        "qwen-image-2-1-turbo/2K": 0.02,
        "seedream-v5-lite": 0.05,
        "z-image-turbo": 0.01
      }
    }
  }
}
