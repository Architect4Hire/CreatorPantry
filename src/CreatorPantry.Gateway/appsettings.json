{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api-health": {
        "ClusterId": "api",
        "Match": { "Path": "/api/health" },
        "Transforms": [
          { "PathSet": "/health" },
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "api-brand-source-correct-extraction": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/workspaces/{workspaceSlug}/brand-source-documents/{documentId}/versions/{versionNumber}/extraction/corrections",
          "Methods": [ "POST" ]
        },
        "MaxRequestBodySize": 9437184,
        "Transforms": [
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "api-brand-source-replace": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/workspaces/{workspaceSlug}/brand-source-documents/{documentId}/versions",
          "Methods": [ "POST" ]
        },
        "MaxRequestBodySize": 22020096,
        "Transforms": [
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "api-brand-source-paste": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/workspaces/{workspaceSlug}/brand-source-documents/text",
          "Methods": [ "POST" ]
        },
        "MaxRequestBodySize": 11534336,
        "Transforms": [
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "api-brand-source-upload": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/workspaces/{workspaceSlug}/brand-source-documents",
          "Methods": [ "POST" ]
        },
        "MaxRequestBodySize": 22020096,
        "Transforms": [
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "api-dam-asset-version-upload": {
        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/workspaces/{workspaceSlug}/dam-assets/{assetId}/versions",
          "Methods": [ "POST" ]
        },
        "MaxRequestBodySize": 34603008,
        "Transforms": [
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "api-dam-asset-upload": {

        "ClusterId": "api",
        "Match": {
          "Path": "/api/v1/workspaces/{workspaceSlug}/dam-assets",
          "Methods": [ "POST" ]
        },
        "MaxRequestBodySize": 34603008,
        "Transforms": [
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      },
      "api": {
        "ClusterId": "api",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [
          { "RequestHeaderRemove": "Authorization" },
          { "RequestHeaderRemove": "Cookie" },
          { "X-Forwarded": "Set", "For": "Set", "Proto": "Set", "Host": "Set", "Prefix": "Off" },
          { "RequestHeaderOriginalHost": "false" }
        ]
      }
    },
    "Clusters": {
      "api": {
        "Destinations": {
          "api": { "Address": "https+http://api" }
        }
      }
    }
  }
}
