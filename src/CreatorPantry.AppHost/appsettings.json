{
  "Foundry": {
    // Off by default: RunAsFoundryLocal() needs the Foundry CLI installed on this machine, and the API and
    // Worker fall back to their unconfigured model clients when no deployment is configured.
    "Enabled": false,
    // On by default, so a new machine is prompted in the dashboard for the endpoint, key and both deployment
    // names instead of starting silently with no model. The API and Worker wait on those four values; a
    // developer with no model account sets this to false in user secrets to start without them. Skipped when
    // a ConnectionStrings:chat/embeddings value or Foundry:LocalCli already supplies a deployment.
    "Azure": true,
    // Which URL shape the prompted endpoint takes. On by default: an Azure OpenAI resource
    // (https://<resource>.openai.azure.com, deployment in the path). Set to false in user secrets for an Azure
    // AI Foundry resource, whose single /models endpoint takes the deployment as a parameter instead.
    "AzureOpenAI": true,
    // Foundry Local model ids. Swapping either one is a configuration change, not a code change; only
    // FoundryModels.Local entries work while RunAsFoundryLocal() is in effect.
    "ChatModel": { "Name": "phi-4-mini", "Version": "5", "Format": "Microsoft" },
    "EmbeddingModel": { "Name": "qwen3-embedding-0.6b", "Version": "1", "Format": "Microsoft" }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  }
}
