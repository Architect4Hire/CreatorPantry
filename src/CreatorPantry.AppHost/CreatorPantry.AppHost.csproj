<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>6996faed-94f9-459f-9aa5-1014acdd27f4</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.5.4" />
    <!--
      Microsoft Foundry (B-15). Preview because Aspire has not shipped this integration stable for 13.5.4;
      it is the same build as the stable 13.5.4 packages beside it.

      Note this pulls in Aspire.Hosting.Azure, so publish mode wants Azure:SubscriptionId,
      Azure:ResourceGroupPrefix and Azure:Location. Run mode uses RunAsFoundryLocal() and wants none of them.
    -->
    <PackageReference Include="Aspire.Hosting.Foundry" Version="13.5.4-preview.1.26464.4" />
    <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.SqlServer" Version="13.5.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CreatorPantry.MigrationService\CreatorPantry.MigrationService.csproj" />
    <ProjectReference Include="..\CreatorPantry.Web\CreatorPantry.Web.csproj" />
    <ProjectReference Include="..\CreatorPantry.Gateway\CreatorPantry.Gateway.csproj" />
    <ProjectReference Include="..\CreatorPantry.ApiService\CreatorPantry.ApiService.csproj" />
    <ProjectReference Include="..\CreatorPantry.Worker\CreatorPantry.Worker.csproj" />
  </ItemGroup>

</Project>
