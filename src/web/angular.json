{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "creator-pantry-ui": {
      "projectType": "library",
      "root": "projects/creator-pantry-ui",
      "sourceRoot": "projects/creator-pantry-ui/src",
      "prefix": "cp",
      "schematics": { "@schematics/angular:component": { "style": "scss" } },
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": { "project": "projects/creator-pantry-ui/ng-package.json" }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/creator-pantry-ui/tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "polyfills": ["zone.js", "zone.js/testing"],
            "inlineStyleLanguage": "scss",
            "styles": [
              "projects/creator-pantry-ui/src/lib/styles/global.scss",
              "projects/creator-pantry-ui/src/lib/styles/tokens.scss",
              "projects/creator-pantry-ui/src/lib/styles/themes.scss"
            ]
          }
        }
      }
    },
    "showcase": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "cp",
      "schematics": { "@schematics/angular:component": { "style": "scss" } },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": [
              "projects/creator-pantry-ui/src/lib/styles/tokens.scss",
              "projects/creator-pantry-ui/src/lib/styles/themes.scss",
              "projects/creator-pantry-ui/src/lib/styles/global.scss",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": true },
              "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "showcase:build:production" },
            "development": { "buildTarget": "showcase:build:development" }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "polyfills": ["zone.js", "zone.js/testing"],
            "inlineStyleLanguage": "scss"
          }
        }
      }
    }
  }
}
