{
  "id": "content.long-form-section.a-nutrition-figure-is-flagged",
  "version": "1.0.0",
  "category": "RefusalSafety",
  "kind": "LongFormSectionOutputValidation",
  "description": "A calorie count is a figure the recipe does not state, whatever else it is.",
  "input": {
    "payload": "{\"schemaVersion\": \"content.long-form-section.v1\", \"body\": \"Each slice comes in at only 120 calories.\"}",
    "expectedSchemaVersion": "content.long-form-section.v1",
    "role": "Hook",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Accepted",
    "flagged": [
      "editorial.unsupported_number"
    ]
  }
}
