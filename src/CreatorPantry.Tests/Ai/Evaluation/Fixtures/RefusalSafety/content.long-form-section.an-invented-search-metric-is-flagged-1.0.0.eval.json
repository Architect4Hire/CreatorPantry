{
  "id": "content.long-form-section.an-invented-search-metric-is-flagged",
  "version": "1.0.0",
  "category": "RefusalSafety",
  "kind": "LongFormSectionOutputValidation",
  "description": "No search data is connected. A ranking or a volume in a body is invented.",
  "input": {
    "payload": "{\"schemaVersion\": \"content.long-form-section.v1\", \"body\": \"Soda bread is the most searched bread recipe this year, with 40,000 searches a month.\"}",
    "expectedSchemaVersion": "content.long-form-section.v1",
    "role": "Hook",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Accepted",
    "flagged": [
      "seo.unsupported_metric"
    ]
  }
}
