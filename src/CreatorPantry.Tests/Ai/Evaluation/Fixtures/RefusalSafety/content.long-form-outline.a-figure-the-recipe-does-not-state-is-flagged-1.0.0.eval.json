{
  "id": "content.long-form-outline.a-figure-the-recipe-does-not-state-is-flagged",
  "version": "1.0.0",
  "category": "RefusalSafety",
  "kind": "LongFormOutlineOutputValidation",
  "description": "The recipe bakes for 45 minutes. An intent that promises twenty is flagged, so a plan cannot carry an invented time into the writing.",
  "input": {
    "payload": "{\"schemaVersion\": \"content.long-form-outline.v1\", \"sections\": [{\"role\": \"Hook\", \"heading\": \"Bread before breakfast\", \"intent\": \"Promise a loaf that is ready in 20 minutes.\"}]}",
    "expectedSchemaVersion": "content.long-form-outline.v1",
    "kind": "BlogArticle",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Accepted",
    "flagged": [
      {
        "sectionIndex": 0,
        "containing": "20 minutes"
      }
    ]
  }
}
