{
  "id": "content.editorial-package.the-same-number-in-another-unit-is-reported",
  "version": "1.0.0",
  "category": "RefusalSafety",
  "kind": "EditorialPackageOutputValidation",
  "description": "A duration is supported only by the same duration in the same unit: 3 days in the storage notes does not support 3 weeks.",
  "input": {
    "payload": "{\"schemaVersion\":\"content.editorial-package.v1\",\"sections\":{\"storageReheating\":{\"text\":\"Refrigerate up to 3 weeks.\"}}}",
    "expectedSchemaVersion": "content.editorial-package.v1",
    "source": {
      "numbers": [
        "220",
        "25",
        "12"
      ],
      "freeText": "Mix the dough. Bake at 220C for 25 minutes. Makes 12 rolls.",
      "storageNotes": "Refrigerate up to 3 days."
    }
  },
  "expect": {
    "outcome": "Accepted",
    "warnings": [
      "editorial.unsupported_number"
    ]
  }
}
