    "role": "Hook",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Accepted",
    "flagged": [
      "editorial.unsupported_number"
    ]
  }
