{
  "id": "content.long-form-outline.a-role-given-as-a-number-is-rejected",
  "version": "1.0.0",
  "category": "SchemaValidity",
  "kind": "LongFormOutlineOutputValidation",
  "description": "A stored role is a number, but a model names a role by its name. A digit string is not a role, however valid the number.",
  "input": {
    "payload": "{\"schemaVersion\": \"content.long-form-outline.v1\", \"sections\": [{\"role\": \"1\", \"heading\": \"The loaf for people who do not bake\", \"intent\": \"Open on how little this bread asks of the cook.\"}]}",
    "expectedSchemaVersion": "content.long-form-outline.v1",
    "kind": "BlogArticle",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Rejected",
    "reasonCode": "ai.output.long_form_outline_role_unknown",
    "category": "DomainInvalid"
  }
}
