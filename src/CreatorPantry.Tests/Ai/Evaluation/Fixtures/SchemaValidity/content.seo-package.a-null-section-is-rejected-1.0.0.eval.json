{
  "id": "content.seo-package.a-null-section-is-rejected",
  "version": "1.0.0",
  "category": "SchemaValidity",
  "kind": "SeoPackageOutputValidation",
  "description": "A JSON null where the schema requires an object is a shape failure, not an exception.",
  "input": {
