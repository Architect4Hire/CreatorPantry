{
  "id": "content.seo-package.a-title-longer-as-written-than-canonically-is-rejected",
  "version": "1.0.0",
  "category": "SchemaValidity",
  "kind": "SeoPackageOutputValidation",
  "description": "Length is measured on the string that is stored, so text that reads shorter after normalisation is still over the limit.",
  "input": {
