{
  "id": "content.long-form-section.a-shortened-address-is-rejected",
  "version": "1.0.0",
  "category": "SchemaValidity",
  "kind": "LongFormSectionOutputValidation",
  "description": "A short link on a domain ending nobody listed first is an invented address like any other.",
  "input": {
    "payload": "{\"schemaVersion\": \"content.long-form-section.v1\", \"body\": \"Find the recipe at bit.ly/soda-bread today.\"}",
    "expectedSchemaVersion": "content.long-form-section.v1",
    "role": "Cta",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Rejected",
    "reasonCode": "ai.output.long_form_section_markup_invalid",
    "category": "DomainInvalid"
  }
}
