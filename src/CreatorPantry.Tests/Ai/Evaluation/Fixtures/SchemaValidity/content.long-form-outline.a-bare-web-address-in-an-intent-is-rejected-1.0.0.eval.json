{
  "id": "content.long-form-outline.a-bare-web-address-in-an-intent-is-rejected",
  "version": "1.0.0",
  "category": "SchemaValidity",
  "kind": "LongFormOutlineOutputValidation",
  "description": "An address needs no scheme to be an address. No address was supplied to plan around, so 'example.com' is refused as 'https://example.com' is.",
  "input": {
    "payload": "{\"schemaVersion\": \"content.long-form-outline.v1\", \"sections\": [{\"role\": \"Cta\", \"heading\": \"Come and bake with us\", \"intent\": \"Send readers to example.com for the full class.\"}]}",
    "expectedSchemaVersion": "content.long-form-outline.v1",
    "kind": "BlogArticle",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Rejected",
    "reasonCode": "ai.output.long_form_outline_intent_invalid",
    "category": "DomainInvalid"
  }
}
