{
  "id": "content.long-form-outline.a-role-from-the-other-kind-is-rejected",
  "version": "1.0.0",
  "category": "SchemaValidity",
  "kind": "LongFormOutlineOutputValidation",
  "description": "A greeting belongs to a newsletter issue. In a blog article it is a role this kind does not have.",
  "input": {
    "payload": "{\"schemaVersion\": \"content.long-form-outline.v1\", \"sections\": [{\"role\": \"Greeting\", \"heading\": \"Hello again\", \"intent\": \"Say hello.\"}, {\"role\": \"Closing\", \"heading\": \"Bake it this weekend\", \"intent\": \"Send the reader off to try it.\"}]}",
    "expectedSchemaVersion": "content.long-form-outline.v1",
    "kind": "BlogArticle",
    "recipes": [
      {
        "title": "Buttermilk Soda Bread",
        "yieldText": "Makes 1 loaf",
        "prepTimeMinutes": 10,
        "cookTimeMinutes": 45,
        "ingredients": [
          "450g plain flour",
          "400ml buttermilk",
          "1 tsp bicarbonate of soda"
        ],
        "steps": [
          "Mix the dry ingredients.",
          "Stir in the buttermilk.",
          "Bake for 45 minutes."
        ]
      }
    ]
  },
  "expect": {
    "outcome": "Rejected",
    "reasonCode": "ai.output.long_form_outline_role_not_allowed",
    "category": "DomainInvalid"
  }
}
