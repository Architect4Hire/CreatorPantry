{
  "openapi": "3.1.1",
  "info": {
    "title": "CreatorPantry API",
    "description": "Browser clients call these routes through CreatorPantry.Gateway with a session cookie. Errors are RFC 9457 problem details carrying a stable \u0060code\u0060 and a \u0060traceId\u0060.",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/account/password": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Changes the signed-in user\u0027s password. Success rotates the security stamp, which ends every session for\nthe user (including this one) at its next revalidation, so the user signs in again with the new password.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AntiforgeryToken"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordViewModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordViewModel"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable \u0060code\u0060 and \u0060traceId\u0060.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "bffSession": []
          }
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registers an account. The 202 response is identical whether or not the email is already registered.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AntiforgeryToken"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserViewModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserViewModel"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationServiceModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationServiceModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegistrationServiceModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable \u0060code\u0060 and \u0060traceId\u0060.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Starts a password reset. The 202 response is identical whether or not the email belongs to an account.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AntiforgeryToken"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetViewModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetViewModel"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/RequestPasswordResetViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable \u0060code\u0060 and \u0060traceId\u0060.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/password-reset/complete": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Completes a password reset. Unknown emails and invalid, expired, or used tokens share one error.",
        "parameters": [
          {
            "$ref": "#/components/parameters/AntiforgeryToken"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletePasswordResetViewModel"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CompletePasswordResetViewModel"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/CompletePasswordResetViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PasswordServiceModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Problem details with a stable \u0060code\u0060 and \u0060traceId\u0060.",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordViewModel": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CompletePasswordResetViewModel": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CursorPage": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {}
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Cursor-paginated collection envelope. Pass \u0060nextCursor\u0060 back as \u0060cursor\u0060; null means no more items."
      },
      "PasswordServiceModel": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "ProblemDetails": {
        "required": [
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code, e.g. \u0060auth.registration.invalid\u0060 or \u0060not_found\u0060."
          },
          "traceId": {
            "type": "string",
            "description": "Correlation id for support and tracing."
          }
        }
      },
      "RegisterUserViewModel": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          }
        }
      },
      "RegistrationServiceModel": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "RequestPasswordResetViewModel": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "ValidationProblemDetails": {
        "required": [
          "code",
          "traceId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable, machine-readable error code, e.g. \u0060auth.registration.invalid\u0060 or \u0060not_found\u0060."
          },
          "traceId": {
            "type": "string",
            "description": "Correlation id for support and tracing."
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Field errors keyed by camelCase request field name."
          }
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "description": "Client-generated key, unique per logical command. Replaying a key returns the original committed result instead of repeating the command.",
        "required": true,
        "schema": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "AntiforgeryToken": {
        "name": "X-XSRF-TOKEN",
        "in": "header",
        "description": "Antiforgery request token from GET /bff/antiforgery (or the sign-in response). Required by the gateway on every unsafe request; a missing or stale token is rejected with 400 csrf.invalid.",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "description": "Opaque cursor from a previous page\u0027s \u0060nextCursor\u0060. Omit for the first page.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum items per page.",
        "schema": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer",
          "format": "int32",
          "default": 25
        }
      }
    },
    "requestBodies": {
      "FileUpload": {
        "description": "Single-file upload. The type is verified by file signature, not extension, and size is capped.",
        "content": {
          "multipart/form-data": {
            "schema": {
              "required": [
                "file"
              ],
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "required": true
      }
    },
    "securitySchemes": {
      "bffSession": {
        "type": "apiKey",
        "description": "HttpOnly session cookie issued by the gateway (BFF). Browsers never handle tokens. Provisional name, finalized with the BFF session.",
        "name": "__Host-creatorpantry-session",
        "in": "cookie"
      }
    }
  },
  "tags": [
    {
      "name": "Account"
    },
    {
      "name": "Auth"
    }
  ]
}
