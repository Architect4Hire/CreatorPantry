<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!--
      Builds the test executable on Microsoft.Testing.Platform rather than xUnit v3's own in-process
      console runner, which is what `global.json`'s "test": { "runner": "Microsoft.Testing.Platform" }
      requires of every test project — the .NET 10 SDK no longer supports the VSTest target at all.
      Without it the executable does not speak MTP, so test listing, the filter options, TRX
      output and coverage are all unavailable. The VSTest packages below stay only for IDE test
      explorers that have not moved to MTP.
    -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!--
      The .NET 9 mechanism for making `dotnet test` drive the MTP runner. Kept because it is harmless, but be
      clear about what it does not achieve:

      `DOTNET TEST DOES NOT WORK ON THIS PROJECT.` It reports "Zero tests ran" and exits 5, whatever this
      property is set to. Verified 2026-09-25 against SDK 10.0.401, xunit.v3 4.0.1 and MTP 2.4.0, from both
      Git Bash and PowerShell, with and without this property, with and without UseMicrosoftTestingPlatformRunner,
      with and without the VSTest packages below, and with MTP pinned to 2.4.1.

      The cause is upstream and narrow. `dotnet test` on the .NET 10 SDK launches the test app in MTP server
      mode (the "server dotnettestcli" argument, with a named pipe); xunit.v3 4.0.1 accepts those arguments
      and exits silently without ever registering its test framework. Running the same assembly in console
      mode discovers and runs all of it, and running it in server mode with a nonexistent pipe still exits 0
      having done nothing, so this is not a build, discovery, filter or environment problem.

      Use `dotnet run` on this project instead. It builds first and runs the whole suite; CLAUDE.md has the
      command. Revisit when xunit.v3 ships past 4.0.1.
    -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CsCheck" Version="4.9.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.15.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!--
    Prompt-template fixtures, embedded the same way CreatorPantry.Domain embeds real ones, so the loader is
    exercised through the resource path it actually uses rather than a string handed to it.
  -->
  <ItemGroup>
    <None Remove="**\*.prompt.md" />
    <EmbeddedResource Include="**\*.prompt.md" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CreatorPantry.AiProvider\CreatorPantry.AiProvider.csproj" />
    <ProjectReference Include="..\CreatorPantry.Domain\CreatorPantry.Domain.csproj" />
    <ProjectReference Include="..\CreatorPantry.ApiService\CreatorPantry.ApiService.csproj" Aliases="ApiService" />
    <ProjectReference Include="..\CreatorPantry.Gateway\CreatorPantry.Gateway.csproj" Aliases="Gateway" />
    <ProjectReference Include="..\CreatorPantry.Web\CreatorPantry.Web.csproj" Aliases="Web" />
    <ProjectReference Include="..\CreatorPantry.MigrationService\CreatorPantry.MigrationService.csproj" />
  </ItemGroup>

</Project>
