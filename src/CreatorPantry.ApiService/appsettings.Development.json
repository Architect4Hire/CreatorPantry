{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Development only. The proposal routes ship dark (see AiTaskOptions): every task is refused until a
  // deployment opts it in, so no environment starts spending a provider budget because a route was deployed.
  // These are the tasks a developer can exercise locally.
  "Ai": {
    "Tasks": {
      "Enabled": [ "diagnostic", "recipe.concepts", "recipe.first-draft", "brand.style-test-drive", "image.photography-concept", "image.prompt", "image.reference-analysis", "recipe.dish-facets" ]
    },
    // Development only. No Ai:Quota:ModelRates are configured, so every provider call settles at the flat
    // per-call estimate (10 credits) and the shipped default of 1000 is about a hundred calls a month. The
    // Worker carries the same value; the two must agree, because the edge peeks and the worker admits.
    "Quota": {
      "DefaultAllowance": 100000
    }
  }
}
