{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Development only. The proposal routes ship dark (see AiTaskOptions): a workspace that has chosen nothing
  // is refused every task not listed here, so no environment starts spending a provider budget because a
  // route was deployed. This is the default a workspace starts from; an Owner can change it per workspace
  // under Workspace settings, and that choice wins.
  // Development only, and seeded with the pricing analysis's "Proposed, awaiting the owner" table so the
  // landing page's pricing section has something to render while it is built (LP.6). Nothing here is decided:
  // AP.1.1 is where these become the owner's figures, and no other environment publishes a catalogue. The
  // ExampleCounts are one month made all together, priced at the Rates below (a text draft about 5, a
  // standard picture 50): illustrations, not entitlements, that the landing page leads each card with.
  "Billing": {
    "PublishPlans": true,
    "Currency": "USD",
    // What an account with no plan of its own is on (AP.4.1). Studio in development (owner, 2026-10-27, AP.4.2):
    // since AP.4.2 a plan sets the allowance and the picture caps, and nothing can move a local account onto
    // another plan until AP.4.4, so the default is the generous one and the trial is left to the tests. Which
    // plan a deployment defaults to is still the daily-limits document's open item. The Worker carries the same
    // plans and default (CreatorPantry.Worker/appsettings.Development.json); PlanCatalogueDriftTests holds them equal.
    "DefaultPlan": "studio",
    "Plans": [
      {
        "Key": "trial",
        "Name": "Trial",
        "MonthlyPrice": 0,
        "AnnualMonthlyPrice": 0,
        "Credits": 1000,
        "ExampleCounts": { "RecipeDrafts": 40, "SocialPosts": 40, "Pictures": 10 },
        "DailyImageCap": 5,
        "Period": "Once",
        "RunningImages": 1,
        "QualityClasses": [ "draft", "standard" ],
        "TrialDays": 14,
        // The trial's gate: pictures it may make in all, no card on file (ai-pricing.md B-52). Decided, unlike
        // the figures around it; nothing enforces it until AP.7.1.
        "TrialImageCap": 10
      },
      {
        "Key": "creator",
        "Name": "Creator",
        "MonthlyPrice": 12,
        "AnnualMonthlyPrice": 9,
        "Credits": 4500,
        "ExampleCounts": { "RecipeDrafts": 60, "SocialPosts": 120, "Pictures": 70 },
        "DailyImageCap": 25,
        "Period": "Monthly",
        "RunningImages": 1,
        "QualityClasses": [ "draft", "standard", "high" ],
        "Recommended": true
      },
      {
        "Key": "pro",
        "Name": "Pro",
        "MonthlyPrice": 49,
        "AnnualMonthlyPrice": 39,
        "Credits": 18000,
        "ExampleCounts": { "RecipeDrafts": 200, "SocialPosts": 400, "Pictures": 300 },
        "DailyImageCap": 75,
        "Period": "Monthly",
        "RunningImages": 2,
        "QualityClasses": [ "draft", "standard", "high", "high-2k" ]
      },
      {
        "Key": "studio",
        "Name": "Studio",
        "MonthlyPrice": 99,
        "AnnualMonthlyPrice": 79,
        "Credits": 36000,
        "ExampleCounts": { "RecipeDrafts": 400, "SocialPosts": 800, "Pictures": 600 },
        "DailyImageCap": 150,
        "Period": "Monthly",
        "RunningImages": 3,
        "QualityClasses": [ "draft", "standard", "high", "high-2k", "high-4k" ]
      }
    ],
    "Packs": [
      { "Key": "small", "Credits": 2500, "Price": 10 },
      { "Key": "medium", "Credits": 7500, "Price": 25 },
      { "Key": "large", "Credits": 20000, "Price": 60 }
    ],
    // What one written action of each kind costs on the public menu (LP.7). Text settles at what the model
    // reported (Ai:Quota:ModelRates, AP.2.1): a recipe draft on gpt-5.4-nano is about 3 credits, so the menu
    // says "about 5" with room for a little reasoning (owner, 2026-10-26). A long-form section stays at 10 to be
    // safe. Pictures are not here any more (AP.4.5): a picture costs its quality class's Ai:Quota:ImageRates row
    // exactly, which is what admission charges, and the menu now reads those rather than a second copy of them.
    // Each plan's ExampleCounts above is priced at these rates plus those, and adds up to no more than its credits.
    // Published in development alone, as with every figure above, until the owner settles them.
    "Rates": {
      "TextDraft": 5,
      "LongFormSection": 10
    }
  },
  "Ai": {
    "Tasks": {
      "Enabled": [ "diagnostic", "recipe.concepts", "recipe.first-draft", "recipe.revision", "recipe.substitution", "recipe.adaptation", "recipe.review", "recipe.proposal-explanation", "brand.style-test-drive", "image.photography-concept", "image.prompt", "image.reference-analysis", "recipe.dish-facets", "content.channel-posts", "content.long-form-outline", "content.long-form-section" ]
    },
    // Development only. Admission still holds the flat per-call estimate (10 credits, twice for a corrective
    // re-ask) before a call, so the shipped default of 1000 admits about fifty runs a month however little each
    // settles at. The Worker carries the same value; the two must agree, because the edge peeks and the worker
    // admits.
    "Quota": {
      "DefaultAllowance": 100000
    }
  }
}
