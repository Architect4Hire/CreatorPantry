<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      This project carries its architectural reasoning in XML doc, so a cref that points at a moved type is
      real damage. Phase 4A's namespace move broke 98 of them and nothing reported it, because doc generation
      was off. Generating the file turns CS1574 (unresolved cref) back into a build warning.

      CS1591 and CS1573 are suppressed deliberately: not every public member needs a comment, and partially
      documented positional records are a house style rather than a defect.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1574</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- The provider-neutral model abstractions only: IChatClient and IEmbeddingGenerator. A provider SDK
         in this assembly is an architectural defect; DomainReferenceTests enforces that. -->
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <!-- ResiliencePipelineProvider only. The pipeline itself is configured in ServiceDefaults, which this
         project may not reference (DomainReferenceTests); Polly is the shared vocabulary between them. -->
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="NodaTime" Version="3.3.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Identity's data-protection token providers (password reset) ship in the ASP.NET Core framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Prompt templates are compiled in, not read from disk, so a prompt cannot drift from the code whose output
    schema it promises and there is no file path for a template to reach through. EmbeddedPromptTemplateStore
    finds them by the .prompt.md suffix, so a template lives beside the module that owns it.
    The None Remove is required because .md files are otherwise picked up as None items, and the same file in
    two item groups is a build error.
  -->
  <ItemGroup>
    <None Remove="**\*.prompt.md" />
    <EmbeddedResource Include="**\*.prompt.md" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CreatorPantry.Tests" />
  </ItemGroup>

  <!-- Application time: only IClock and ITimeZoneConverter may read the clock or resolve zones. -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);RS0030</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\BannedSymbols.txt" />
  </ItemGroup>

</Project>
